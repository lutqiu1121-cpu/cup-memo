<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Cup Memo ships a single light theme: the off-white background is fixed,
         so the "night" window theme uses exactly the same colours to avoid a
         black flash while the Flutter engine starts (even when the OS is in
         Dark Mode). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/cup_memo_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/cup_memo_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/cup_memo_background</item>
    </style>
</resources>
